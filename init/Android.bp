prebuilt_etc {
    name: "fstab.default",
    src: "etc/fstab.default",
    vendor: true,
}

prebuilt_first_stage_ramdisk {
    name: "fstab.default.first_stage_ramdisk",
    src: "etc/fstab.default",
    vendor_ramdisk: true,
    install_in_root: true,
}

prebuilt_etc {
    name: "init.qcom.rc",
    src: "etc/init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "etc/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "etc/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "etc/ueventd.qcom.rc",
    vendor: true,
}
